# ── Supabase (Dashboard → Project Settings → API Keys) ──
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Dùng "Publishable key" (sb_publishable_...) hoặc "anon" key cũ (eyJ...) đều được
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# ── Khoá mã hoá dữ liệu (CHỈ SERVER, tuyệt đối không thêm tiền tố NEXT_PUBLIC_) ──
# 32 byte ngẫu nhiên dạng base64. Tạo bằng:  openssl rand -base64 32
# MẤT KHOÁ = MẤT TOÀN BỘ chat, bảng vẽ, hồ sơ đã mã hoá. Hãy lưu bản sao ở trình quản lý mật khẩu.
ENCRYPTION_KEY=
# Chỉ dùng khi xoay vòng khoá: đặt khoá CŨ ở đây, khoá MỚI ở ENCRYPTION_KEY
ENCRYPTION_KEY_PREVIOUS=

# ── Đăng nhập Google: "true" để hiện nút (phải bật provider Google trong Supabase trước) ──
NEXT_PUBLIC_AUTH_GOOGLE=false

# ── Email góp ý qua Resend (miễn phí 3.000 mail/tháng). Bỏ trống = chỉ lưu DB ──
RESEND_API_KEY=
# Chưa verify domain trên Resend → phải là đúng email đã đăng ký Resend (dùng được dạng ten+bantron@gmail.com)
FEEDBACK_TO_EMAIL=
# Bỏ trống = onboarding@resend.dev. Đã verify domain → "Bàn Tròn <gopy@domain-cua-ban.com>"
FEEDBACK_FROM_EMAIL=
